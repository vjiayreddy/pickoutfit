# Copy to .env.local after you install deps
#
# Node: Eve requires Node.js >= 24 (see .nvmrc). With nvm:
#   nvm install && nvm use

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Same as NEXT_PUBLIC_CONVEX_URL but ends in .site
NEXT_PUBLIC_CONVEX_SITE_URL=
# Your local / public site URL (must match Convex SITE_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Convex deployment env (not Next.js) ─────────────────────────────
# Auth (required):
#   npx convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32)
#   npx convex env set SITE_URL http://localhost:3000
#
# AI pipelines — detect / extract / render / embed (set one of):
#   npx convex env set OPENAI_API_KEY sk-...
#   npx convex env set AI_GATEWAY_API_KEY ...
#
# Stripe billing — create products/prices + webhook in Dashboard first:
#   npx convex env set STRIPE_SECRET_KEY sk_test_...   # or sk_live_...
#   npx convex env set STRIPE_WEBHOOK_SECRET whsec_...
#   npx convex env set STRIPE_PRICE_PRO price_...
#   npx convex env set STRIPE_PRICE_PLUS price_...
# Optional: allow non-admin test plan grants without Stripe
#   npx convex env set ALLOW_DEV_SMOKE 1
#
# Eve stylist — same value in .env.local AND Convex:
#   openssl rand -hex 32
#   npx convex env set AGENT_SERVICE_KEY <that-value>
AGENT_SERVICE_KEY=
# Optional local Eve without browser JWT:
#   AGENT_DEV_AUTH_ID=<users.authId from Convex dashboard>
#
# Launch notes:
# - Signed-in preview of marketing: http://localhost:3000/?preview=landing
# - First admin: dashboard → users → set role = "admin" (no self-promote)
# - Demo wardrobe seed needs SITE_URL reachable so Convex can fetch /demo-wardrobe/*
